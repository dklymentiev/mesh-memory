# Mesh Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials

# PostgreSQL (defaults match docker-compose.yml)
POSTGRES_DB=meshdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5433/meshdb

# API Server
ENVIRONMENT=production

# Security - Authentication
# Set to true to require X-API-Key header on all endpoints (except /health)
AUTH_REQUIRED=false
# Comma-separated list of valid API keys (required when AUTH_REQUIRED=true)
API_KEYS=

# Security - Network
# Comma-separated CIDR ranges for IP whitelist (empty = allow all)
IP_WHITELIST=
# Trust CF-Connecting-IP / X-Real-IP headers (set true only behind trusted proxy)
TRUST_PROXY_HEADERS=false
# Comma-separated CORS origins (empty = deny all cross-origin requests)
CORS_ORIGINS=https://yourdomain.com

# Rate Limiting (requests per minute, 0 = unlimited)
RATE_LIMIT_SEARCH=60
RATE_LIMIT_EMBED=30

# Content Limits
# Maximum document size in characters (documents exceeding this are rejected)
MAX_CONTENT_LENGTH=50000

# Database Pool
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Embeddings model (must match vector dimensions in database schema)
# Default: intfloat/multilingual-e5-base (768 dimensions)
# Note: only the first 4000 chars of each document are used for embedding
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Minimum cosine similarity threshold for search results (0.0-1.0)
SIMILARITY_THRESHOLD=0.1

# Logging & Debug
LOG_LEVEL=INFO
DEBUG=false

# AI Categorizer (opt-in, works without these -- see README)
CATEGORIZER_ENABLED=false
LLM_API_URL=                         # OpenAI-compatible endpoint (e.g. https://openrouter.ai/api/v1)
LLM_API_KEY=
LLM_MODEL=                           # e.g. google/gemini-2.0-flash-001
CATEGORIZER_THRESHOLD=0.55           # Min confidence for category assignment
CATEGORIZER_SUB_THRESHOLD=0.50       # Min confidence for subcategory
CATEGORIZER_LLM_TIMEOUT=15           # LLM request timeout in seconds

# Traefik reverse proxy hostnames
TRAEFIK_HOST=mesh.yourdomain.com
TRAEFIK_DEMO_HOST=mesh-demo.yourdomain.com
